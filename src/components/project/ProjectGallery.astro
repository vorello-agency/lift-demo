---
import Eyebrow from "../shared/Eyebrow.astro";
import { Image } from "astro:assets";
import MediaViewer, { type MediaViewerSlideItem } from "./MediaViewer.astro";
import type { ProjectGalleryItem } from "../../data/projects";

interface Props {
  gallery: ProjectGalleryItem[];
  headline: string;
  description: string;
}

const { gallery, headline, description } = Astro.props;
const hasGalleryImages = gallery.length > 0;
const headingId = "project-gallery-title";

const gallerySlides: MediaViewerSlideItem[] = gallery.map((item) => ({
  image: item.image,
  alt: item.alt,
  caption: item.caption,
}));
---

{
  hasGalleryImages && (
    <section
      class="border-t border-concrete/40 bg-warm-white dark:border-white/[0.08] dark:bg-obsidian"
      aria-labelledby={headingId}>
      <div class="container-lift pb-16 pt-32 sm:pb-20 lg:pb-28">
        <div class="mb-10 grid grid-cols-1 gap-5 border-b border-concrete/60 pb-8 dark:border-white/[0.08] sm:mb-14 sm:pb-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5" data-motion-project-reveal>
            <Eyebrow as="h2" id={headingId} text="Galería" size="xs" class="mb-5" />
            <p class="text-pretty font-display text-3xl font-bold leading-[1.1] text-ink dark:text-chalk sm:text-4xl">
              {headline}
            </p>
          </div>

          <div class="lg:col-span-5 lg:col-start-8" data-motion-project-reveal>
            <p class="max-w-xl text-pretty text-sm leading-relaxed text-charcoal dark:text-ash sm:text-base">
              {description}
            </p>
          </div>
        </div>

        <div class="gallery-lanes">
          {gallery.map((item, index) => (
            <figure class="gallery-lane-item group" data-motion-gallery-item>
              <button
                type="button"
                class="group relative block w-full cursor-pointer overflow-hidden rounded-sm bg-concrete/20 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange dark:bg-dark-surface"
                data-gallery-open={index}
                aria-haspopup="dialog"
                aria-label={`Ampliar fotografía ${index + 1} de la galería: ${item.alt}`}>
                <Image
                  src={item.image}
                  alt=""
                  class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:group-hover:scale-100"
                  loading="lazy"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 100vw"
                />
              </button>
              {item.caption && (
                <figcaption class="flex gap-3 border-t border-concrete/50 pt-3 text-xs leading-relaxed text-charcoal dark:border-white/[0.08] dark:text-ash">
                  <span class="mt-[0.45rem] h-px w-5 shrink-0 bg-lift-orange" aria-hidden="true" />
                  <span>{item.caption}</span>
                </figcaption>
              )}
            </figure>
          ))}
        </div>

        <div
          class="mt-12 flex flex-col justify-between gap-4 border-t border-concrete/60 pt-6 dark:border-white/[0.08] sm:mt-16 sm:flex-row sm:items-center sm:pt-8"
          data-motion-project-reveal>
          <div class="flex items-center gap-2 font-mono text-xs text-charcoal dark:text-ash">
            <span class="font-semibold text-ink dark:text-chalk">{String(gallery.length).padStart(2, "0")}</span>
            <span class="text-[11px] uppercase tracking-[0.14em] text-charcoal/70 dark:text-ash/70">
              {gallery.length === 1 ? "registro visual" : "registros visuales"}
            </span>
          </div>

          <p class="max-w-xl text-xs leading-relaxed text-charcoal/75 dark:text-ash/70 sm:text-right">
            Visualizaciones conceptuales generadas con IA.
          </p>
        </div>
      </div>

      <MediaViewer
        id="gallery-viewer"
        triggerAttribute="data-gallery-open"
        sectionTitle="Galería"
        slides={gallerySlides}
      />
    </section>
  )
}

<style>
  .gallery-lanes {
    columns: 1;
    column-gap: 1rem;
  }

  .gallery-lane-item {
    display: inline-grid;
    width: 100%;
    gap: 0.75rem;
    margin-bottom: 1rem;
    break-inside: avoid;
  }

  @media (min-width: 640px) {
    .gallery-lanes {
      columns: 2;
      column-gap: 1.25rem;
    }

    .gallery-lane-item {
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-lanes {
      columns: 3;
      column-gap: 1.5rem;
    }

    .gallery-lane-item {
      margin-bottom: 1.5rem;
    }
  }

  @supports (display: grid-lanes) {
    .gallery-lanes {
      display: grid-lanes;
      columns: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .gallery-lane-item {
      display: grid;
      margin-bottom: 0;
    }

    @media (min-width: 640px) {
      .gallery-lanes {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }
    }

    @media (min-width: 1024px) {
      .gallery-lanes {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
      }
    }
  }
</style>
