---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBasePath } from "../../utils/urls";
import Eyebrow from "../shared/Eyebrow.astro";
import ConceptualBadge from "../shared/ConceptualBadge.astro";

interface Props {
  name: string;
  subtitle: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
}

const { name, subtitle, heroImage, heroImageAlt } = Astro.props;
---

<section id="hero" class="relative min-h-[85dvh] w-full overflow-hidden bg-ink text-white lg:min-h-[100dvh]">
  <div class="absolute inset-0 z-0 h-full w-full">
    <Image
      src={heroImage}
      alt={heroImageAlt}
      class="h-full w-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      widths={[800, 1200, 1920]}
      sizes="100vw"
    />
  </div>

  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-t from-ink/95 via-ink/40 to-ink/60"
    aria-hidden="true">
  </div>

  <div
    class="relative z-10 flex min-h-[85dvh] w-full flex-col justify-between pb-12 pt-28 sm:pb-16 sm:pt-32 lg:min-h-[100dvh] lg:pb-20">
    <div class="container-lift">
      <nav aria-label="Ubicación" class="project-hero-fade-in">
        <ol class="flex flex-wrap items-center gap-2 font-sans text-xs text-white/70 sm:text-sm">
          <li>
            <a
              href={withBasePath("")}
              class="rounded-xs transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange">
              Inicio
            </a>
          </li>
          <li aria-hidden="true">
            <span class="text-white/40">/</span>
          </li>
          <li>
            <a
              href={withBasePath("#projects")}
              class="rounded-xs transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange">
              Proyectos
            </a>
          </li>
          <li aria-hidden="true">
            <span class="text-white/40">/</span>
          </li>
          <li>
            <span class="font-medium text-white" aria-current="page">
              {name}
            </span>
          </li>
        </ol>
      </nav>
    </div>

    <div class="container-lift mt-auto pt-12">
      <div class="project-hero-fade-in max-w-4xl space-y-4 sm:space-y-6">
        <Eyebrow text={subtitle} size="xs" tone="inverse" />

        <h1
          class="font-display text-4xl font-bold leading-[1.05] tracking-[var(--tracking-display-large)] text-white sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl">
          {name}
        </h1>

        <div class="pt-2 sm:pt-1">
          <ConceptualBadge tone="inverse" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .project-hero-fade-in {
    animation: projectHeroFadeIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  @keyframes projectHeroFadeIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero-fade-in {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
