---
import Eyebrow from "../shared/Eyebrow.astro";
interface Props {
  year: number;
  category: string;
  area: string;
  materiality: string;
}

const { year, category, area, materiality } = Astro.props;

const metaFields = [
  { label: "Año", value: String(year) },
  { label: "Tipología", value: category },
  { label: "Superficie", value: area },
  { label: "Materialidad", value: materiality },
];
const headingId = "project-meta-title";
---

<section class="border-b border-concrete/60 bg-warm-white" aria-labelledby={headingId}>
  <div class="container-lift py-10 sm:py-14 lg:py-16">
    <div data-motion-project-reveal>
      <Eyebrow as="h2" id={headingId} text="Ficha técnica" size="xs" class="mb-8 sm:mb-10" />
    </div>

    <dl class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4 sm:gap-y-6" data-motion-project-group>
      {
        metaFields.map((field) => (
          <div class="flex flex-col gap-1.5">
            <dt class="font-sans text-[11px] font-semibold uppercase tracking-[0.16em] text-lift-orange-dark sm:text-xs">
              {field.label}
            </dt>
            <dd class="font-sans text-sm font-semibold leading-snug text-ink sm:text-base">{field.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
