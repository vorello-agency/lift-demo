---
import Eyebrow from "../shared/Eyebrow.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBasePath } from "../../utils/urls";
import arrowLeftIcon from "@phosphor-icons/core/assets/light/arrow-left-light.svg?raw";
import arrowRightIcon from "@phosphor-icons/core/assets/light/arrow-right-light.svg?raw";

interface AdjacentProject {
  slug: string;
  name: string;
  category: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
}

interface Props {
  prev: AdjacentProject;
  next: AdjacentProject;
}

const { prev, next } = Astro.props;
const headingId = "project-navigation-title";
---

<nav class="border-t border-concrete/60 bg-subtle" aria-labelledby={headingId}>
  <div class="container-lift py-12 sm:py-16 lg:py-20">
    <div data-motion-project-reveal>
      <Eyebrow as="h2" id={headingId} text="Explorar proyectos" size="xs" class="mb-8 sm:mb-10" />
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:gap-12" data-motion-project-group>
      <a
        href={withBasePath(`projects/${prev.slug}/`)}
        class="group -m-1 flex flex-col gap-4 rounded-sm p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange"
        aria-label={`Proyecto anterior: ${prev.name}`}>
        <div class="flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-[0.15em] text-charcoal">
          <span
            class="h-4 w-4 text-charcoal transition-all duration-300 group-hover:-translate-x-1 group-hover:text-lift-orange-dark motion-reduce:transform-none motion-reduce:group-hover:translate-x-0 [&>svg]:h-full [&>svg]:w-full"
            aria-hidden="true"
            set:html={arrowLeftIcon}
          />
          <span>Anterior</span>
        </div>

        <div class="relative aspect-[16/9] overflow-hidden rounded-sm bg-concrete/20">
          <Image
            src={prev.heroImage}
            alt={prev.heroImageAlt}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:group-hover:scale-100"
            loading="lazy"
            widths={[600, 900, 1200, 1600]}
            sizes="(min-width: 1280px) 640px, (min-width: 640px) 50vw, 100vw"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-ink/5 transition-colors duration-300 group-hover:bg-ink/10"
            aria-hidden="true">
          </div>
        </div>

        <div class="space-y-1">
          <h3
            class="font-display text-lg font-bold leading-snug text-ink transition-colors duration-300 group-hover:text-lift-orange-dark sm:text-xl">
            {prev.name}
          </h3>
          <p class="font-sans text-xs font-medium text-charcoal sm:text-sm">
            {prev.category}
          </p>
        </div>
      </a>

      <a
        href={withBasePath(`projects/${next.slug}/`)}
        class="group -m-1 flex flex-col gap-4 rounded-sm p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange sm:items-end sm:text-right"
        aria-label={`Proyecto siguiente: ${next.name}`}>
        <div class="flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-[0.15em] text-charcoal">
          <span>Siguiente</span>
          <span
            class="h-4 w-4 text-charcoal transition-all duration-300 group-hover:translate-x-1 group-hover:text-lift-orange-dark motion-reduce:transform-none motion-reduce:group-hover:translate-x-0 [&>svg]:h-full [&>svg]:w-full"
            aria-hidden="true"
            set:html={arrowRightIcon}
          />
        </div>

        <div class="relative aspect-[16/9] w-full overflow-hidden rounded-sm bg-concrete/20">
          <Image
            src={next.heroImage}
            alt={next.heroImageAlt}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:group-hover:scale-100"
            loading="lazy"
            widths={[600, 900, 1200, 1600]}
            sizes="(min-width: 1280px) 640px, (min-width: 640px) 50vw, 100vw"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-ink/5 transition-colors duration-300 group-hover:bg-ink/10"
            aria-hidden="true">
          </div>
        </div>

        <div class="space-y-1">
          <h3
            class="font-display text-lg font-bold leading-snug text-ink transition-colors duration-300 group-hover:text-lift-orange-dark sm:text-xl">
            {next.name}
          </h3>
          <p class="font-sans text-xs font-medium text-charcoal sm:text-sm">
            {next.category}
          </p>
        </div>
      </a>
    </div>
  </div>
</nav>
