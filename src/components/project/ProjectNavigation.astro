---
import Eyebrow from "../shared/Eyebrow.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { withBasePath } from "../../utils/urls";
import arrowLeftIcon from "@phosphor-icons/core/assets/light/arrow-left-light.svg?raw";
import arrowRightIcon from "@phosphor-icons/core/assets/light/arrow-right-light.svg?raw";

interface AdjacentProject {
  slug: string;
  name: string;
  category: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  previewImages?: ImageMetadata[];
}

interface Props {
  prev: AdjacentProject;
  next: AdjacentProject;
}

const { prev, next } = Astro.props;
const headingId = "project-navigation-title";

const prevImages = (prev.previewImages && prev.previewImages.length > 0 ? prev.previewImages : [prev.heroImage]).slice(0, 4);
const nextImages = (next.previewImages && next.previewImages.length > 0 ? next.previewImages : [next.heroImage]).slice(0, 4);

const prevOptimizedImages = await Promise.all(
  prevImages.map((img) =>
    getImage({
      src: img,
      format: "webp",
      quality: 85,
      width: 960,
      height: 540,
    })
  )
);

const nextOptimizedImages = await Promise.all(
  nextImages.map((img) =>
    getImage({
      src: img,
      format: "webp",
      quality: 85,
      width: 960,
      height: 540,
    })
  )
);
---

<nav
  class="border-t border-concrete/60 bg-subtle dark:border-white/[0.08] dark:bg-dark-subtle"
  aria-labelledby={headingId}>
  <div class="container-lift py-12 sm:py-16 lg:py-20">
    <div data-motion-project-reveal>
      <Eyebrow as="h2" id={headingId} text="Explorar proyectos" size="xs" class="mb-8 sm:mb-10" />
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 lg:gap-12" data-motion-project-group>
      <a
        href={withBasePath(`projects/${prev.slug}/`)}
        class="project-nav-card group -m-1 flex flex-col gap-4 rounded-sm p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange"
        aria-label={`Proyecto anterior: ${prev.name}`}
        data-project-nav-card>
        <div
          class="flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-[0.15em] text-charcoal dark:text-ash">
          <span
            class="h-4 w-4 text-charcoal transition-all duration-300 group-hover:-translate-x-1 group-hover:text-lift-orange-dark motion-reduce:transform-none motion-reduce:group-hover:translate-x-0 dark:text-ash dark:group-hover:text-lift-orange [&>svg]:h-full [&>svg]:w-full"
            aria-hidden="true"
            set:html={arrowLeftIcon}
          />
          <span>Anterior</span>
        </div>

        <div
          class="project-nav-card__media relative aspect-[16/9] w-full overflow-hidden rounded-sm bg-concrete/20 dark:bg-dark-surface"
          data-project-nav-gallery>
          {
            prevOptimizedImages.map((optImg, index) => (
              <img
                src={index === 0 ? optImg.src : undefined}
                data-src={index !== 0 ? optImg.src : undefined}
                alt=""
                aria-hidden={index !== 0 ? "true" : undefined}
                width={960}
                height={540}
                loading="lazy"
                decoding="async"
                class={`project-nav-card__image absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:group-hover:scale-100 ${index === 0 ? "is-active" : ""}`}
                data-gallery-item
                data-index={index}
              />
            ))
          }
          <div
            class="pointer-events-none absolute inset-0 z-10 bg-ink/5 transition-colors duration-300 group-hover:bg-ink/10 dark:bg-white/5 dark:group-hover:bg-white/10"
            aria-hidden="true">
          </div>
          {
            prevOptimizedImages.length > 1 && (
              <div
                class="project-nav-card__progress sm:h-6.5 sm:w-6.5 pointer-events-none absolute bottom-2 right-2 z-20 h-6 w-6 drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)] sm:bottom-2.5 sm:right-2.5"
                aria-hidden="true"
                data-project-nav-progress>
                <svg class="h-full w-full -rotate-90" viewBox="0 0 24 24" aria-hidden="true">
                  <circle
                    cx="12"
                    cy="12"
                    r="9.5"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    class="text-white/35"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="9.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    fill="none"
                    class="project-nav-card__progress-indicator text-lift-orange"
                    style={`stroke-dasharray: 59.6903; stroke-dashoffset: ${(59.6903 * (1 - 1 / prevOptimizedImages.length)).toFixed(4)};`}
                    data-progress-circle
                  />
                </svg>
              </div>
            )
          }
        </div>

        <div class="space-y-1">
          <h3
            class="font-display text-lg font-bold leading-snug text-ink transition-colors duration-300 group-hover:text-lift-orange-dark dark:text-chalk dark:group-hover:text-lift-orange sm:text-xl">
            {prev.name}
          </h3>
          <p class="font-sans text-xs font-medium text-charcoal dark:text-ash sm:text-sm">
            {prev.category}
          </p>
        </div>
      </a>

      <a
        href={withBasePath(`projects/${next.slug}/`)}
        class="project-nav-card group -m-1 flex flex-col gap-4 rounded-sm p-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange sm:items-end sm:text-right"
        aria-label={`Proyecto siguiente: ${next.name}`}
        data-project-nav-card>
        <div
          class="flex items-center gap-2 font-sans text-xs font-semibold uppercase tracking-[0.15em] text-charcoal dark:text-ash">
          <span>Siguiente</span>
          <span
            class="h-4 w-4 text-charcoal transition-all duration-300 group-hover:translate-x-1 group-hover:text-lift-orange-dark motion-reduce:transform-none motion-reduce:group-hover:translate-x-0 dark:text-ash dark:group-hover:text-lift-orange [&>svg]:h-full [&>svg]:w-full"
            aria-hidden="true"
            set:html={arrowRightIcon}
          />
        </div>

        <div
          class="project-nav-card__media relative aspect-[16/9] w-full overflow-hidden rounded-sm bg-concrete/20 dark:bg-dark-surface"
          data-project-nav-gallery>
          {
            nextOptimizedImages.map((optImg, index) => (
              <img
                src={index === 0 ? optImg.src : undefined}
                data-src={index !== 0 ? optImg.src : undefined}
                alt=""
                aria-hidden={index !== 0 ? "true" : undefined}
                width={960}
                height={540}
                loading="lazy"
                decoding="async"
                class={`project-nav-card__image absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transform-none motion-reduce:group-hover:scale-100 ${index === 0 ? "is-active" : ""}`}
                data-gallery-item
                data-index={index}
              />
            ))
          }
          <div
            class="pointer-events-none absolute inset-0 z-10 bg-ink/5 transition-colors duration-300 group-hover:bg-ink/10 dark:bg-white/5 dark:group-hover:bg-white/10"
            aria-hidden="true">
          </div>
          {
            nextOptimizedImages.length > 1 && (
              <div
                class="project-nav-card__progress sm:h-6.5 sm:w-6.5 pointer-events-none absolute bottom-2 right-2 z-20 h-6 w-6 drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)] sm:bottom-2.5 sm:right-2.5"
                aria-hidden="true"
                data-project-nav-progress>
                <svg class="h-full w-full -rotate-90" viewBox="0 0 24 24" aria-hidden="true">
                  <circle
                    cx="12"
                    cy="12"
                    r="9.5"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    class="text-white/35"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="9.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    fill="none"
                    class="project-nav-card__progress-indicator text-lift-orange"
                    style={`stroke-dasharray: 59.6903; stroke-dashoffset: ${(59.6903 * (1 - 1 / nextOptimizedImages.length)).toFixed(4)};`}
                    data-progress-circle
                  />
                </svg>
              </div>
            )
          }
        </div>

        <div class="space-y-1">
          <h3
            class="font-display text-lg font-bold leading-snug text-ink transition-colors duration-300 group-hover:text-lift-orange-dark dark:text-chalk dark:group-hover:text-lift-orange sm:text-xl">
            {next.name}
          </h3>
          <p class="font-sans text-xs font-medium text-charcoal dark:text-ash sm:text-sm">
            {next.category}
          </p>
        </div>
      </a>
    </div>
  </div>
</nav>

<style>
  .project-nav-card__image {
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms ease-in-out, transform 700ms ease-out;
    will-change: opacity, transform;
  }

  .project-nav-card__image.is-active {
    opacity: 1;
    z-index: 2;
  }

  .project-nav-card__image.is-previous {
    opacity: 1;
    z-index: 1;
  }

  .project-nav-card__progress {
    opacity: 1;
    transition: opacity 300ms ease-in-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-nav-card__progress {
      opacity: 0;
    }

    .project-nav-card:hover .project-nav-card__progress,
    .project-nav-card:focus-within .project-nav-card__progress {
      opacity: 1;
    }
  }

  .project-nav-card__progress-indicator {
    transition: stroke-dashoffset 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-nav-card__image {
      transition: none !important;
      transform: none !important;
    }
    .project-nav-card__image:not(:first-child) {
      display: none !important;
    }
    .project-nav-card__image:first-child {
      opacity: 1 !important;
      z-index: 1 !important;
    }
    .project-nav-card__progress {
      display: none !important;
    }
    .project-nav-card__progress-indicator {
      transition: none !important;
    }
  }
</style>

<script>
  import { setupProjectNavGalleries } from "../../utils/service-gallery";

  let cleanupGalleries: (() => void) | null = null;

  function init() {
    cleanupGalleries?.();
    cleanupGalleries = setupProjectNavGalleries();
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    cleanupGalleries?.();
    cleanupGalleries = null;
  });
</script>
