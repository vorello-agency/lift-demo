---
import Eyebrow from "../shared/Eyebrow.astro";
import TechnicalDocument from "./TechnicalDocument.astro";
import MediaViewer, { type MediaViewerSlideItem } from "./MediaViewer.astro";
import type { ProjectTechnicalDocument, ProjectTechnicalMemory } from "../../data/projects";

interface Props {
  projectName: string;
  technicalMemory: ProjectTechnicalMemory;
}

const { projectName, technicalMemory } = Astro.props;
const renderDocuments = technicalMemory.renders ?? [];
const [featuredRender, companionRender, ...additionalRenders] = renderDocuments;
const [featuredDocument, companionDocument, ...additionalDocuments] = technicalMemory.documents;

const allDocuments: ProjectTechnicalDocument[] = [...renderDocuments, ...technicalMemory.documents];

const slideIndexMap = new Map<ProjectTechnicalDocument, number>();
const technicalSlides: MediaViewerSlideItem[] = [];

allDocuments.forEach((doc) => {
  if (doc.image) {
    slideIndexMap.set(doc, technicalSlides.length);
    technicalSlides.push({
      image: doc.image,
      alt: doc.alt ?? `${doc.title} del proyecto ${projectName}`,
      title: doc.title,
      type: doc.type,
      caption: doc.caption,
      credit: doc.credit,
    });
  }
});

const hasPublishedDocuments = technicalSlides.length > 0;
const headingId = "project-technical-memory-title";
---

<section
  class="overflow-hidden border-t border-white/10 bg-ink text-white"
  aria-labelledby={headingId}
  data-project-technical-memory>
  <div class="container-lift pb-20 pt-32 sm:pb-24 lg:py-32">
    <div class="grid grid-cols-1 gap-10 border-b border-white/15 pb-12 lg:grid-cols-12 lg:gap-8 lg:pb-16">
      <div class="lg:col-span-5" data-motion-project-reveal>
        <Eyebrow as="h2" id={headingId} text="Memoria técnica" size="xs" tone="inverse" class="mb-7" />
        <p class="max-w-xl font-display text-3xl font-bold leading-[1.12] text-white sm:text-4xl lg:text-5xl">
          {technicalMemory.headline}
        </p>
      </div>

      <div class="flex flex-col justify-end lg:col-span-6 lg:col-start-7" data-motion-project-reveal>
        <p class="max-w-2xl text-pretty text-base leading-[1.75] text-white/65 sm:text-lg">
          {technicalMemory.introduction}
        </p>
        <p class="mt-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-white/40">
          <span class="h-2 w-2 rounded-full bg-lift-orange" aria-hidden="true"></span>
          {
            hasPublishedDocuments
              ? technicalMemory.statusLabel ?? "Documentación técnica"
              : "Estructura preparada para documentación verificada"
          }
        </p>
      </div>
    </div>

    {
      featuredRender && (
        <div class="mt-12 lg:mt-16">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-8">
              <TechnicalDocument
                document={featuredRender}
                index={0}
                slideIndex={slideIndexMap.get(featuredRender)}
                projectName={projectName}
                featured={true}
                coverMedia={true}
                preloadMedia={true}
              />
            </div>

            {companionRender && (
              <div class="lg:col-span-4">
                <TechnicalDocument
                  document={companionRender}
                  index={1}
                  slideIndex={slideIndexMap.get(companionRender)}
                  projectName={projectName}
                  coverMedia={true}
                  preloadMedia={true}
                />
              </div>
            )}
          </div>

          {additionalRenders.length > 0 && (
            <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:gap-8">
              {additionalRenders.map((document, index) => (
                <TechnicalDocument
                  document={document}
                  index={index + 2}
                  slideIndex={slideIndexMap.get(document)}
                  projectName={projectName}
                  uniformMedia={true}
                  coverMedia={true}
                  preloadMedia={true}
                />
              ))}
            </div>
          )}
        </div>
      )
    }

    {
      featuredDocument && renderDocuments.length > 0 && (
        <div class="mt-16 sm:mt-20">
          <p class="mb-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/45">Documentación técnica</p>
          <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
            {technicalMemory.documents.map((document, index) => (
              <TechnicalDocument
                document={document}
                index={renderDocuments.length + index}
                slideIndex={slideIndexMap.get(document)}
                projectName={projectName}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      featuredDocument && renderDocuments.length === 0 && (
        <div class="mt-12 lg:mt-16">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-8">
              <TechnicalDocument
                document={featuredDocument}
                index={0}
                slideIndex={slideIndexMap.get(featuredDocument)}
                projectName={projectName}
                featured={true}
              />
            </div>

            {companionDocument && (
              <div class="lg:col-span-4">
                <TechnicalDocument
                  document={companionDocument}
                  index={1}
                  slideIndex={slideIndexMap.get(companionDocument)}
                  projectName={projectName}
                />
              </div>
            )}
          </div>

          {additionalDocuments.length > 0 && (
            <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-8">
              {additionalDocuments.map((document, index) => (
                <TechnicalDocument
                  document={document}
                  index={index + 2}
                  slideIndex={slideIndexMap.get(document)}
                  projectName={projectName}
                  uniformMedia={true}
                />
              ))}
            </div>
          )}
        </div>
      )
    }

    <div class="mt-16 border-t border-white/15 pt-8 sm:mt-20 sm:pt-10">
      <div class="mb-8 flex items-center justify-between gap-6" data-motion-project-reveal>
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-white/50">Principios técnicos</h3>
        <span class="text-xs font-medium text-white/30">
          {String(technicalMemory.highlights.length).padStart(2, "0")} principios
        </span>
      </div>

      <ol class="grid grid-cols-1 border-t border-white/15 md:grid-cols-3" data-motion-project-group>
        {
          technicalMemory.highlights.map((highlight, index) => (
            <li class="border-b border-white/15 py-7 md:border-b-0 md:border-r md:px-7 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
              <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-lift-orange">
                {String(index + 1).padStart(2, "0")} — {highlight.label}
              </span>
              <h4 class="mt-4 font-display text-xl font-bold leading-tight text-white sm:text-2xl">
                {highlight.title}
              </h4>
              <p class="mt-3 text-sm leading-relaxed text-white/55">{highlight.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <MediaViewer
    id="technical-viewer"
    triggerAttribute="data-technical-open"
    sectionTitle="Memoria técnica"
    slides={technicalSlides}
    showSlideTitles={false}
  />
</section>

<script>
  let cleanupTechnicalPreviewLoading: (() => void) | null = null;

  function setupTechnicalPreviewLoading() {
    cleanupTechnicalPreviewLoading?.();

    const section = document.querySelector<HTMLElement>("[data-project-technical-memory]");
    if (!section) return;

    const images = Array.from(section.querySelectorAll<HTMLImageElement>("[data-technical-preview]"));
    if (images.length === 0) return;

    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean };
      }
    ).connection;

    if (connection?.saveData || !("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const image = entry.target as HTMLImageElement;
          observer.unobserve(image);
          image.loading = "eager";
          image.fetchPriority = "low";
          void image.decode().catch(() => undefined);
        });
      },
      { rootMargin: "1400px 0px", threshold: 0.01 }
    );

    images.forEach((image) => observer.observe(image));
    cleanupTechnicalPreviewLoading = () => observer.disconnect();
  }

  function destroyTechnicalPreviewLoading() {
    cleanupTechnicalPreviewLoading?.();
    cleanupTechnicalPreviewLoading = null;
  }

  document.addEventListener("astro:page-load", setupTechnicalPreviewLoading);
  document.addEventListener("astro:before-swap", destroyTechnicalPreviewLoading);
</script>
