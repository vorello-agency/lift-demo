---
interface Props {
  id: string;
  name: string;
  type?: "text" | "email" | "tel" | "url" | "number";
  label: string;
  required?: boolean;
  placeholder?: string;
  errorId: string;
  errorMessage: string;
}

const { id, name, type = "text", label, required = false, placeholder = "", errorId, errorMessage } = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="font-sans text-xs font-semibold uppercase tracking-wider text-charcoal">
    {label}
    {
      required && (
        <span class="text-lift-orange" aria-hidden="true">
          *
        </span>
      )
    }
  </label>
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    aria-required={required ? "true" : "false"}
    aria-describedby={errorId}
    class="w-full rounded-md border border-concrete/60 bg-white px-4 py-3 font-sans text-sm text-ink shadow-sm transition-colors focus:border-lift-orange focus:outline-none focus:ring-2 focus:ring-lift-orange"
    placeholder={placeholder}
  />
  <span id={errorId} class="hidden font-sans text-xs text-red-600">
    {errorMessage}
  </span>
</div>
