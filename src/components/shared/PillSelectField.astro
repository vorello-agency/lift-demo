---
interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  required?: boolean;
  containerId: string;
  options: Option[];
  errorId?: string;
  errorMessage?: string;
}

const { id, name, label, required = false, containerId, options, errorId, errorMessage } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span id={`label-${id}`} class="font-sans text-xs font-semibold uppercase tracking-wider text-charcoal dark:text-ash">
    {label}
    {
      required && (
        <span class="text-lift-orange" aria-hidden="true">
          *
        </span>
      )
    }
  </span>
  <input type="hidden" id={id} name={name} required={required} />
  <div class="flex flex-wrap gap-2.5" id={containerId} role="radiogroup" aria-labelledby={`label-${id}`}>
    {
      options.map((opt) => (
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-value={opt.value}
          class="pill-btn inline-flex cursor-pointer select-none items-center gap-1.5 rounded-md border border-concrete/60 bg-white px-4 py-2 font-sans text-sm font-medium text-ink transition-all duration-200 hover:border-lift-orange/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lift-orange dark:border-white/[0.12] dark:bg-dark-surface dark:text-chalk/90 dark:hover:border-lift-orange/70 dark:hover:bg-dark-elevated">
          <svg
            class="pill-check-icon hidden h-3.5 w-3.5 scale-50 text-white opacity-0 transition-all duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="3.2"
            aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{opt.label}</span>
        </button>
      ))
    }
  </div>
  {
    errorId && errorMessage && (
      <span id={errorId} class="hidden font-sans text-xs text-red-600">
        {errorMessage}
      </span>
    )
  }
</div>
