---
import Eyebrow from "./Eyebrow.astro";
interface Props {
  id: string;
  label: string;
  title: string;
  description: string;
  borderClass?: string;
}

const { id, label, title, description, borderClass = "pb-8 lg:border-b border-concrete/60" } = Astro.props;
---

<div class:list={["flex flex-col justify-between gap-6 lg:flex-row lg:items-end", borderClass]}>
  <div class="max-w-2xl space-y-3 sm:space-y-4">
    <Eyebrow text={label} />
    <h2 id={id} class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl">
      {title}
    </h2>
  </div>

  <p class="max-w-xl shrink-0 text-pretty text-base font-normal leading-relaxed text-charcoal sm:text-lg lg:max-w-md">
    {description}
  </p>
</div>
