---
import { Image } from "astro:assets";
import AboutImage from "../assets/images/about.webp";
import PrincipleCard from "../components/content/PrincipleCard.astro";
import Eyebrow from "../components/shared/Eyebrow.astro";
---

<section
  id="about"
  class="overflow-hidden border-b border-concrete bg-subtle py-16 text-ink dark:border-white/[0.08] dark:bg-obsidian dark:text-chalk sm:py-24 lg:py-32"
  aria-labelledby="about-title">
  <div class="container-lift space-y-16 sm:space-y-20 lg:space-y-24">
    <div class="flex flex-col items-center gap-8 sm:gap-10 lg:flex-row lg:gap-12">
      <div class="w-full space-y-6 sm:space-y-8 lg:w-1/2" data-motion-reveal>
        <Eyebrow text="Nosotros" />

        <h2
          id="about-title"
          class="text-balance font-display text-3xl font-bold leading-[1.12] text-ink dark:text-chalk sm:text-4xl md:text-5xl lg:text-5xl">
          Construir bien es<br class="hidden sm:inline" /> pensar a largo plazo.
        </h2>

        <div class="max-w-xl space-y-4">
          <p class="text-pretty text-base font-normal leading-relaxed text-charcoal dark:text-ash sm:text-lg">
            En Lift, el proyecto no termina cuando empieza la obra. Diseño, estructura, materiales y ejecución se
            revisan como partes de una misma decisión.
          </p>
          <p class="text-pretty text-sm font-normal leading-relaxed text-ink/60 dark:text-ash/70 sm:text-base">
            Esa continuidad permite anticipar encuentros, ajustar recursos y conservar la intención arquitectónica hasta
            el último detalle construido.
          </p>
        </div>

        <div
          class="grid grid-cols-1 grid-rows-2 gap-4 border-t border-concrete/60 pt-4 font-mono text-xs uppercase tracking-wider text-ink/60 dark:border-white/[0.08] dark:text-ash/70 md:grid-cols-2 md:grid-rows-1">
          <div>
            <span class="mb-1 block font-sans text-xs font-bold tracking-normal text-ink dark:text-chalk">
              Tipologías
            </span>
            Residencial • Comercial • Edilicio
          </div>
          <div>
            <span class="mb-1 block font-sans text-xs font-bold tracking-normal text-ink dark:text-chalk">Enfoque</span>
            Proyecto y ejecución coordinados
          </div>
        </div>
      </div>

      <div class="w-full pt-8 sm:pt-0 lg:w-1/2" data-motion-reveal data-motion-delay="0.08">
        <div
          class="group relative aspect-[4/3] overflow-hidden rounded-md bg-concrete/20 dark:bg-dark-surface sm:aspect-[4/3]">
          <Image
            src={AboutImage}
            alt="Equipo de arquitectos y profesionales revisando planos de obra sobre una mesa de trabajo"
            class="h-full w-full object-cover object-center contrast-[1.03] grayscale-[15%] transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transform-none motion-reduce:group-hover:scale-100"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="border-concrete dark:border-white/[0.08] sm:pt-14 md:border-t">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3 lg:gap-12 xl:gap-16" data-motion-reveal-group>
        <PrincipleCard
          title="Resolver antes de construir"
          description="Coordinamos estructura, instalaciones y terminaciones en proyecto para reducir correcciones durante la obra."
        />
        <PrincipleCard
          title="Elegir cómo envejece"
          description="Seleccionamos materiales por su respuesta al uso, al clima y al mantenimiento, no solo por su apariencia inicial."
        />
        <PrincipleCard
          title="Hacer visible el proceso"
          description="Registramos decisiones, responsables y avances para que el estado de la obra pueda entenderse en cada etapa."
        />
      </div>
    </div>
  </div>
</section>
