---
import Marquee from "../components/shared/Marquee.astro";
import Eyebrow from "../components/shared/Eyebrow.astro";

const tickerItems = [
  "LECTURA DEL SITIO",
  "ORDEN ESTRUCTURAL",
  "MATERIALES DURABLES",
  "CONTROL DE OBRA",
  "DETALLE CONSTRUCTIVO",
  "USO EN EL TIEMPO",
];
---

<section
  id="manifiesto"
  data-motion-manifesto
  class="relative overflow-hidden bg-warm-white pb-0 pt-8 text-ink dark:border-t dark:border-white/[0.08] dark:bg-obsidian dark:text-chalk sm:pt-14 lg:pt-24 xl:pt-32 3xl:pt-40 4k:pt-48"
  aria-labelledby="manifesto-title">
  <div class="container-lift">
    <div class="grid grid-cols-1 items-start gap-6 sm:gap-8 lg:grid-cols-12">
      <div class="lg:col-span-3" data-motion-manifesto-eyebrow>
        <Eyebrow text="Manifiesto" />
      </div>

      <div class="lg:col-span-9">
        <blockquote
          id="manifesto-title"
          data-motion-manifesto-quote
          class="text-pretty font-display text-3xl font-bold leading-[1.16] text-ink dark:text-chalk sm:text-balance sm:text-4xl md:text-5xl lg:text-6xl">
          <span data-motion-manifesto-clause>“Una obra permanece cuando</span>{" "}<span data-motion-manifesto-clause>
            estructura, uso y material
          </span>{" "}<span data-motion-manifesto-clause>responden a una misma decisión.”</span>
        </blockquote>
      </div>
    </div>
  </div>

  <div data-motion-manifesto-marquee>
    <Marquee items={tickerItems} />
  </div>
</section>
