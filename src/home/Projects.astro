---
import ProjectCard from "../components/content/ProjectCard.astro";
import { getImage } from "astro:assets";
import { getAllProjects } from "../data/projects";
import { withBasePath } from "../utils/urls";
import SectionHeader from "../components/shared/SectionHeader.astro";

const projects = getAllProjects();
const heroWidths = [800, 1200, 1920];
const projectHeroImages = await Promise.all(
  projects.map(async ({ heroImage }) => {
    const variants = await Promise.all(heroWidths.map((width) => getImage({ src: heroImage, width })));

    return {
      src: variants[1].src,
      srcset: variants.map(({ src }, index) => `${src} ${heroWidths[index]}w`).join(", "),
    };
  })
);
---

<section
  id="projects"
  class="overflow-hidden border-b border-concrete/60 bg-warm-white py-16 text-ink dark:border-white/[0.08] dark:bg-dark-subtle dark:text-chalk sm:py-24 lg:py-32"
  aria-labelledby="projects-title">
  <div class="container-lift space-y-8 sm:space-y-16 lg:space-y-20">
    <div data-motion-projects-header>
      <SectionHeader
        id="projects-title"
        label="PROYECTOS"
        title="El lugar define la forma"
        description="Estudios sobre altura, densidad, pendiente y borde costero. Cada proyecto parte de una condición distinta y desarrolla una respuesta propia."
        borderClass="pb-6 border-b border-concrete/60 dark:border-white/[0.08]"
      />
    </div>

    <div class="grid grid-cols-1 items-start gap-12 sm:gap-14 md:grid-cols-12 md:gap-8 lg:gap-12 xl:gap-14">
      {
        projects.map((project, index) => (
          <div
            class={project.gridClass}
            data-motion-project-card
            data-motion-order={index}
            data-project-hero-src={projectHeroImages[index].src}
            data-project-hero-srcset={projectHeroImages[index].srcset}>
            <ProjectCard
              index={project.index}
              title={project.name}
              subtitle={project.subtitle}
              description={project.introduction}
              area={project.area}
              year={String(project.year)}
              imageSrc={project.cardImage}
              imageAlt={project.heroImageAlt}
              imageSizes={
                project.gridClass.includes("col-span-7")
                  ? "(min-width: 1920px) 850px, (min-width: 1360px) 720px, (min-width: 768px) 52vw, 92vw"
                  : "(min-width: 1920px) 590px, (min-width: 1360px) 500px, (min-width: 768px) 37vw, 92vw"
              }
              aspectRatioClass={project.aspectRatioClass}
              href={withBasePath(`projects/${project.slug}/`)}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const preloadedHeroes = new Set<string>();
  let cleanupPreloads: (() => void) | undefined;

  function setupProjectPreloads() {
    cleanupPreloads?.();
    const controller = new AbortController();
    const timers = new Set<ReturnType<typeof setTimeout>>();
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;

    document.querySelectorAll<HTMLElement>("[data-project-hero-src]").forEach((card) => {
      let hoverTimer: ReturnType<typeof setTimeout> | undefined;
      const cancelHover = () => {
        if (hoverTimer === undefined) return;
        clearTimeout(hoverTimer);
        timers.delete(hoverTimer);
        hoverTimer = undefined;
      };
      const preload = () => {
        cancelHover();
        const src = card.dataset.projectHeroSrc;
        if (
          !src ||
          preloadedHeroes.has(src) ||
          connection?.saveData ||
          ["slow-2g", "2g"].includes(connection?.effectiveType ?? "")
        )
          return;

        preloadedHeroes.add(src);
        const image = new Image();
        image.fetchPriority = "low";
        image.sizes = "100vw";
        image.srcset = card.dataset.projectHeroSrcset ?? "";
        image.src = src;
      };

      card.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType !== "mouse") return;
          cancelHover();
          hoverTimer = setTimeout(preload, 150);
          timers.add(hoverTimer);
        },
        { signal: controller.signal }
      );
      card.addEventListener("pointerleave", cancelHover, { signal: controller.signal });
      card.addEventListener("focusin", preload, { signal: controller.signal });
      card.addEventListener(
        "pointerdown",
        (event) => {
          if (event.isPrimary && event.button === 0) preload();
        },
        { signal: controller.signal }
      );
    });

    cleanupPreloads = () => {
      controller.abort();
      timers.forEach(clearTimeout);
    };
  }

  setupProjectPreloads();
  document.addEventListener("astro:page-load", setupProjectPreloads);
  document.addEventListener("astro:before-swap", () => cleanupPreloads?.());
</script>
