---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/shared/Button.astro";
import Eyebrow from "../components/shared/Eyebrow.astro";
import skylineImg from "../assets/images/skyline-404.webp";
import { withBasePath } from "../utils/urls";
---

<Layout
  title="Página no encontrada — Lift Construcciones"
  description="El enlace al que intentas acceder no existe, ha cambiado de dirección o fue removido.">
  <section
    id="hero"
    class="relative flex min-h-[100dvh] min-h-screen w-full items-center justify-center overflow-hidden bg-ink pb-16 pt-24 text-white sm:pb-24 sm:pt-32"
    aria-labelledby="not-found-title">
    <Image
      src={skylineImg}
      alt=""
      role="presentation"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full select-none object-cover object-center"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      quality={90}
      format="webp"
      loading="eager"
    />

    <div
      class="pointer-events-none absolute inset-0 z-[1] bg-ink/40 bg-gradient-to-t from-ink/90 via-ink/35 to-ink/50"
      aria-hidden="true">
    </div>

    <div class="container-lift relative z-10 flex max-w-3xl flex-col items-center px-4 text-center">
      <Eyebrow text="Error 404" size="sm" tone="inverse" class="mb-6 justify-center" />

      <h1
        id="not-found-title"
        class="mb-6 text-balance font-display text-4xl font-bold leading-[1.08] tracking-[var(--tracking-display-large)] text-white sm:text-5xl md:text-6xl lg:text-7xl">
        Página no encontrada.
      </h1>

      <p class="mx-auto mb-10 max-w-xl text-pretty font-sans text-base leading-relaxed text-concrete/85 sm:text-lg">
        El enlace al que intentas acceder no existe, ha cambiado de dirección o fue removido.
      </p>

      <div class="flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row">
        <Button
          href={withBasePath("")}
          variant="primary"
          size="md"
          withArrow={true}
          text="Volver al inicio"
          ariaLabel="Volver al inicio del sitio"
          class="w-full sm:w-auto"
        />
        <Button
          href={withBasePath("#projects")}
          variant="secondary"
          size="md"
          text="Ver proyectos"
          ariaLabel="Explorar catálogo de proyectos"
          class="w-full sm:w-auto"
        />
      </div>
    </div>
  </section>
</Layout>
